<resources>
    <!-- Compose draws the UI; this theme only covers the window before the
         first frame. values-night overrides it for dark mode. -->
    <style name="Theme.ShellGuard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
